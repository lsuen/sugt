{
  "name": "sugt",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:app": "tauri dev",
    "dev:app:store": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:SUGT_PRODUCT='store'; npm run tauri dev\"",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "package:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1 -Variant self",
    "package:release:zip": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1 -Variant self -Zip",
    "package:release:public": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1 -Variant public -TrialDays 180",
    "package:release:public:zip": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1 -Variant public -TrialDays 180 -Zip",
    "package:release:self": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1 -Variant self",
    "package:release:self:zip": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1 -Variant self -Zip",
    "package:release:store:self": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1 -Product store -Variant self",
    "package:release:store:self:zip": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1 -Product store -Variant self -Zip",
    "package:release:store:public": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1 -Product store -Variant public -TrialDays 180",
    "package:release:store:public:zip": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1 -Product store -Variant public -TrialDays 180 -Zip",
    "package:release:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release-all.ps1",
    "package:release:all:zip": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release-all.ps1 -Zip",
    "package:release:wizard": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release-wizard.ps1",
    "package:release:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1 -Variant public -TrialDays 180 -Test",
    "test:connectivity": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-connectivity.ps1",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "export:public": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/export-public-tree.ps1 -Clean",
    "export:public:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/export-public-tree.ps1 -VerifyOnly"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-shell": "^2.3.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@tauri-apps/cli-win32-x64-msvc": "^2.9.0",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
