{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "SUGT 主窗口默认权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "core:tray:default",
    "core:menu:default",
    "shell:default",
    "allow-get-status",
    "allow-start-gateway",
    "allow-stop-gateway",
    "allow-list-providers",
    "allow-save-provider",
    "allow-delete-provider",
    "allow-restore-experimental-zen",
    "allow-set-active-provider",
    "allow-set-provider-enabled",
    "allow-test-provider",
    "allow-list-provider-models",
    "allow-set-failover",
    "allow-set-autostart",
    "allow-set-autostart-gateway",
    "allow-set-auto-takeover",
    "allow-set-quit-behavior",
    "allow-read-logs",
    "allow-get-config",
    "allow-open-config-dir",
    "allow-get-clients-env-status",
    "allow-install-clients-env",
    "allow-repair-clients-env",
    "allow-uninstall-clients-env",
    "allow-update-gateway-settings",
    "allow-test-provider-draft",
    "allow-quick-gateway-chat",
    "allow-takeover-commands",
    "allow-store-commands"
  ]
}
