{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SUGT",
  "version": "0.2.1",
  "identifier": "com.qmtech.sugt",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SUGT - su gateway",
        "width": 1040,
        "height": 680,
        "minWidth": 960,
        "minHeight": 640,
        "maxWidth": 1200,
        "maxHeight": 820,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#070b14",
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright © 2026 孙文龙. All rights reserved.",
    "category": "DeveloperTool",
    "shortDescription": "SUGT su gateway",
    "longDescription": "Lightweight OpenAI-compatible gateway for Claude Code, Codex and domestic LLM providers.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
